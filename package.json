{
  "name": "kassa-pro-desktop",
  "version": "1.1.13",
  "description": "Desktop POS prototype for retail stores.",
  "main": "dist-electron/electron/main.js",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "admin:dev": "node scripts/admin-dev.cjs",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build:renderer": "vite build",
    "build": "tsc -p tsconfig.electron.json && tsc -p tsconfig.json --noEmit && vite build",
    "start": "tsc -p tsconfig.electron.json && tsc -p tsconfig.json --noEmit && vite build && electron ."
  },
  "dependencies": {
    "@types/sql.js": "^1.4.9",
    "@zxing/browser": "^0.2.0",
    "@zxing/library": "^0.22.0",
    "electron": "^31.7.7",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sql.js": "^1.12.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^20.19.25",
    "@types/react": "^18.3.27",
    "@types/react-dom": "^18.3.7",
    "typescript": "^5.9.3",
    "vite": "^5.4.21"
  }
}
